VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (opcional). Site key de reCAPTCHA v3 del proyecto Firebase.
# Si lo dejas vacío, App Check NO se inicializa y la app funciona igual
# (mientras no actives el enforcement en la consola de Firebase).
# Es una clave PÚBLICA: viaja en el bundle, como el resto de la config.
VITE_RECAPTCHA_SITE_KEY=

# Error tracking (opcional). Si lo dejas vacío, no se carga Sentry: solo
# quedan los handlers globales locales. Pega aquí el DSN de tu proyecto Sentry
# para activar el reporte de errores en producción.
VITE_SENTRY_DSN=

# Hosts (CSV) desde los que SÍ se envían errores a Sentry. Por defecto solo el
# dominio oficial; así un fork desplegado en otro github.io no manda errores a
# tu proyecto. Cámbialo si usas un dominio propio. Ej: midominio.com,www.midominio.com
VITE_SENTRY_ALLOWED_HOSTS=
