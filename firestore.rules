rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function socialReader(uid) {
      let me = request.auth.uid;
      let pair = me < uid ? me + '_' + uid : uid + '_' + me;
      return me == uid
        || exists(/databases/$(database)/documents/friendships/$(pair))
        || exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + me));
    }
    function validPhoto(photo) {
      return photo == null || (photo is string && photo.size() <= 500
        && photo.matches('https://[a-zA-Z0-9.-]+[.]googleusercontent[.]com/.*'));
    }
    function validIdentity(d, uid) {
      return d.uid == uid && d.displayName is string && d.displayName.size() <= 100
        && (d.avatarId == null || (d.avatarId is string && d.avatarId.size() <= 50))
        && validPhoto(d.photoURL);
    }
    function validUser() {
      let d = request.resource.data;
      return d.keys().hasOnly(['userName', 'profile', 'progress', 'extra', 'clientId', 'updatedAt'])
        && (!('userName' in d) || (d.userName is string && d.userName.size() <= 100))
        && (!('profile' in d) || d.profile is map)
        && (!('progress' in d) || d.progress is map)
        && (!('extra' in d) || d.extra is map)
        && (!('clientId' in d) || (d.clientId is string && d.clientId.size() <= 100))
        && d.updatedAt == request.time;
    }
    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid','displayName','avatarId','photoURL','level','totalXP','weeklyXP','currentStreak','friendCode','updatedAt'])
        && validIdentity(d, uid) && d.updatedAt == request.time
        && d.friendCode is string && d.friendCode.matches('[A-Z0-9]{6}')
        && getAfter(/databases/$(database)/documents/friendCodes/$(d.friendCode)).data.uid == uid
        && d.level is int && d.level >= 1 && d.level <= 100
        && d.totalXP is int && d.totalXP >= 0 && d.totalXP <= 10000000
        && d.weeklyXP is int && d.weeklyXP >= 0 && d.weeklyXP <= d.totalXP
        && d.currentStreak is int && d.currentStreak >= 0 && d.currentStreak <= 20000;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser();
      allow delete: if isOwner(uid);
    }
    // Informal XP is self-reported; only owner, friends and invitation receivers can read it.
    match /publicProfiles/{uid} {
      allow get: if signedIn() && socialReader(uid);
      allow create: if isOwner(uid) && validProfile(uid);
      allow update: if isOwner(uid) && validProfile(uid)
        && request.resource.data.friendCode == resource.data.friendCode;
      allow delete: if isOwner(uid)
        && !existsAfter(/databases/$(database)/documents/friendCodes/$(resource.data.friendCode));
    }
    // Discovery exposes identity only, never personal progress or scores.
    match /socialIdentities/{uid} {
      allow get: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid','displayName','avatarId','photoURL'])
        && validIdentity(request.resource.data, uid);
      allow delete: if isOwner(uid);
    }
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (!exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
          || get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.friendCode == code)
        && getAfter(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.friendCode == code;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Atomic invitation counter: 20 per rolling day, at least 20 seconds apart.
    // Clients cannot reset or delete the counter. It contains no identity or progress.
    match /socialLimits/{uid} {
      function validLimit() {
        let d = request.resource.data;
        return d.keys().hasOnly(['count','windowStart','lastInviteAt','lastRequestId'])
          && d.count is int && d.count >= 1 && d.count <= 20
          && d.lastRequestId is string && d.lastRequestId.size() <= 257
          && d.windowStart is timestamp && d.lastInviteAt == request.time;
      }
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && validLimit()
        && request.resource.data.count == 1 && request.resource.data.windowStart == request.time;
      allow update: if isOwner(uid) && validLimit()
        && request.time >= resource.data.lastInviteAt + duration.value(20, 's')
        && ((request.time < resource.data.windowStart + duration.value(1, 'd')
             && request.resource.data.windowStart == resource.data.windowStart
             && request.resource.data.count == resource.data.count + 1)
          || (request.time >= resource.data.windowStart + duration.value(1, 'd')
             && request.resource.data.windowStart == request.time && request.resource.data.count == 1));
    }
    match /friendRequests/{reqId} {
      function validRequest() {
        let d = request.resource.data;
        let limit = getAfter(/databases/$(database)/documents/socialLimits/$(request.auth.uid)).data;
        return d.keys().hasOnly(['from','to','fromName','fromAvatarId','fromPhotoURL','toName','toAvatarId','toPhotoURL','createdAt'])
          && d.from == request.auth.uid && d.to is string && d.to.size() > 0 && d.to.size() <= 128
          && d.from != d.to && reqId == d.from + '_' + d.to
          && d.createdAt == request.time && limit.lastInviteAt == request.time && limit.lastRequestId == reqId
          && exists(/databases/$(database)/documents/publicProfiles/$(d.to))
          && d.fromName is string && d.fromName.size() <= 100
          && d.toName is string && d.toName.size() <= 100
          && (d.fromAvatarId == null || (d.fromAvatarId is string && d.fromAvatarId.size() <= 50))
          && (d.toAvatarId == null || (d.toAvatarId is string && d.toAvatarId.size() <= 50))
          && validPhoto(d.fromPhotoURL) && validPhoto(d.toPhotoURL);
      }
      allow get: if signedIn() && (reqId.matches(request.auth.uid + '_.*') || reqId.matches('.*_' + request.auth.uid));
      allow list, delete: if signedIn() && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if signedIn() && validRequest();
    }
    match /friendships/{pairId} {
      function myPair() {
        return pairId.matches(request.auth.uid + '_.*') || pairId.matches('.*_' + request.auth.uid);
      }
      allow get: if signedIn() && myPair();
      allow list, delete: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members','createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string && request.resource.data.members[1] is string
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/friendRequests/$(
          (request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]) + '_' + request.auth.uid));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
